# {{PROJECT_NAME}}: copy to .env and fill in. NEVER commit .env (it's git-ignored).

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:{{DB_PORT}}/{{PROJECT_SLUG}}

# --- Auth ---
# Signs session tokens. Required, 32+ random bytes: openssl rand -base64 48
JWT_SECRET=

# Sign in with Google: an OAuth client of type "Web application" (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:{{API_PORT}}/api/auth/google/callback

# --- API ---
# The web app's origin: the only origin CORS allows, and where Google sign-in lands
WEB_ORIGIN=http://localhost:{{WEB_PORT}}
# Production only, when web and API are on sibling subdomains (app.example.com + api.example.com -> example.com)
COOKIE_DOMAIN=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:{{API_PORT}}

# --- Mobile (apps/mobile): a physical device needs your machine's LAN IP instead of localhost ---
EXPO_PUBLIC_API_URL=http://localhost:{{API_PORT}}
